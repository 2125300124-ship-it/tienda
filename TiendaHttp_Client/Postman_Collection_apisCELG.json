{
  "info": {
    "name": "Actividad 3.4 - API REST Admin Sanctum",
    "_postman_id": "apisCELG-collection-3.4",
    "description": "Colección completa para la Actividad 3.4 con autenticación SANCTUM desde la tabla administradores y CRUDs para Administradores, Productos (con imágenes), Proveedores, Clientes y Pedidos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "0. Demostración Sin Token (401)",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{base_url}}/productos",
          "host": ["{{base_url}}"],
          "path": ["productos"]
        },
        "description": "Demuestra que sin token las rutas privadas rechazan la petición con HTTP 401 Unauthorized."
      }
    },
    {
      "name": "1. Autenticación Administrador",
      "item": [
        {
          "name": "Login Administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.token) {",
                  "        pm.environment.set('token', jsonData.token);",
                  "        console.log('Token guardado en entorno:', jsonData.token);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            }
          }
        },
        {
          "name": "Perfil Admin (Validar Token)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/perfil",
              "host": ["{{base_url}}"],
              "path": ["perfil"]
            }
          }
        },
        {
          "name": "Logout Administrador",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/logout",
              "host": ["{{base_url}}"],
              "path": ["logout"]
            }
          }
        }
      ]
    },
